<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to open the loopback server socket (127.0.0.1 only, see protocol.md section 11). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No activities: the agent runs only under `am instrument`. -->
    <application
        android:allowBackup="false"
        android:label="Prism agent" />
</manifest>
